{
  "name": "@pactum/cli",
  "version": "0.1.0",
  "description": "Terminal CLI tool for Pactum Trust Layer power users and developers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pactum": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pactum/sdk": "file:../../sdk/js",
    "@stellar/stellar-sdk": "^16.2.0",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.10",
    "tsup": "^8.5.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
